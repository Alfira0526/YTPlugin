# ====================================================================
# 환경변수 템플릿 — 복사해서 `.env`로 사용하세요 (`.env`는 절대 커밋 금지)
#   cp .env.example .env
# ====================================================================

# --- MT (번역) ---
# DeepL Free API 키 (개발계획서 v1.1 §3-2, 1차 후보)
#   발급: https://www.deepl.com/pro-api  (Free 플랜, 월 50만자)
DEEPL_API_KEY=

# Papago (대안, Naver Cloud Platform) — 무료한도 실측 대상 (파일럿 ③)
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# --- STT 백엔드 선택 ---
# qwen3-asr | sensevoice | stub(오프라인 검증용)
STT_BACKEND=stub

# --- MT 백엔드 선택 ---
# deepl | papago | stub(오프라인 검증용)
MT_BACKEND=stub

# --- 모델 캐시 경로 (weights 저장 위치) ---
HF_HOME=./models/hf
MODELSCOPE_CACHE=./models/modelscope
